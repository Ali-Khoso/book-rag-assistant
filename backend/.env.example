SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only secret key. Never place this in frontend/.env.local or a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
FRONTEND_ORIGIN=http://localhost:3000
BOOKS_BUCKET=books-private
MAX_PDF_SIZE_BYTES=52428800

# PDF text extraction and text chunking
MAX_PDF_PAGES=2000
MAX_EXTRACTED_CHARS=5000000
CHUNK_SIZE_CHARS=1400
CHUNK_OVERLAP_CHARS=200
MAX_DOCUMENT_CHUNKS=5000

# Embeddings: the default local model runs without a paid API key.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=minishlab/potion-base-8M
EMBEDDING_REVISION=bf8b056651a2c21b8d2565580b8569da283cab23
MODEL_CACHE_DIR=.cache/models
EMBEDDING_BATCH_SIZE=64
# Optional hosted, OpenAI-compatible endpoint. Keep the real key in backend/.env.
# EMBEDDING_PROVIDER=api
# EMBEDDING_API_URL=https://your-provider.example/v1/embeddings
# EMBEDDING_API_KEY=your_private_embedding_key
# EMBEDDING_MODEL=your_256_dimension_embedding_model
# EMBEDDING_REVISION=v1

# Processing status and retry
PROCESSING_ENABLED=true
PROCESSING_POLL_SECONDS=3

# Phase 3: grounded answers. Local Ollama does not need an API key.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=180
ANSWER_RETRIEVAL_K=6
ANSWER_CONTEXT_CHARS=9000
ANSWER_MIN_SIMILARITY=0.25
CONVERSATION_HISTORY_TURNS=4
# Optional OpenAI Responses API. Set a supported model and keep the key private.
# LLM_PROVIDER=openai
# LLM_MODEL=your_structured_output_model
# OPENAI_API_KEY=your_private_key

# Phase 4: durable operational controls. Run migration 0005 before enabling this version.
ENVIRONMENT=development
LIMITS_ENABLED=true
MAX_BOOKS_PER_USER=20
MAX_STORAGE_BYTES_PER_USER=524288000
READ_REQUESTS_PER_MINUTE=120
UPLOAD_REQUESTS_PER_MINUTE=5
SEARCH_REQUESTS_PER_MINUTE=20
ASK_REQUESTS_PER_MINUTE=5
QUESTIONS_PER_DAY=100
UPLOADS_PER_DAY=20
MAX_CONCURRENT_ANSWERS_PER_USER=1
PROCESSING_MAX_ATTEMPTS=3
DELETION_MAX_ATTEMPTS=8
WORKER_HEARTBEAT_SECONDS=10
WARM_MODELS=false
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# Optional private metrics bearer token. Never expose it through NEXT_PUBLIC variables.
# MONITORING_TOKEN=your_random_private_monitoring_token
# For a separate worker, set PROCESSING_ENABLED=false and run python -m app.worker.
