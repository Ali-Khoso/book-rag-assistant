# Copy to backend.env on the server; this file is excluded from Git and images.
ENVIRONMENT=production
SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
FRONTEND_ORIGIN=https://books.example.com
ALLOWED_HOSTS=["books.example.com","api","localhost","127.0.0.1"]
LIMITS_ENABLED=true
PROCESSING_ENABLED=false
MAX_BOOKS_PER_USER=20
MAX_STORAGE_BYTES_PER_USER=524288000
ASK_REQUESTS_PER_MINUTE=5
QUESTIONS_PER_DAY=100
PROCESSING_MAX_ATTEMPTS=3
DELETION_MAX_ATTEMPTS=8
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_URL=http://ollama:11434
# Generate a private token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITORING_TOKEN=REPLACE_WITH_A_RANDOM_32_CHARACTER_TOKEN
