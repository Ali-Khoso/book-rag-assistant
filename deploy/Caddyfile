{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 53477376
    }
    header Strict-Transport-Security "max-age=31536000"
    handle /api/* {
        reverse_proxy api:8000 {
            transport http {
                response_header_timeout 330s
            }
        }
    }
    handle {
        reverse_proxy web:3000
    }
}
